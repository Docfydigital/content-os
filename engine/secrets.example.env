# Content OS — SEGREDOS (copie para secrets.env e preencha; NUNCA suba no git)
# Depois de preencher, proteja: chmod 600 secrets.env

# Apify — coleta de posts (Instagram, TikTok, YouTube). https://apify.com -> Settings -> API tokens
APIFY_TOKEN=SUA_KEY_AQUI

# Google Gemini — analise, roteiros e leitura de thumbnail. https://ai.google.dev (Get API key)
GEMINI_API_KEY=SUA_KEY_AQUI

# Postpeer — publicacao nas redes (opcional; so pra publicar o calendario). https://postpeer.dev
POSTPEER_API_KEY=SUA_KEY_AQUI

# Vercel — deploy da dashboard (opcional; so pra publicar online). https://vercel.com/account/tokens
VERCEL_TOKEN=SUA_KEY_AQUI
